# A secret must never enter a build context — it would survive in an image layer.
.env
.env.*
!.env.example

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
tests/

# macOS AppleDouble / Finder junk (null bytes break Alembic if copied into versions/)
._*
.DS_Store
**/.DS_Store
**/._*
