# Env template — copy to `.env` and fill locally. Never commit `.env`.
# Values here are placeholders only. Never paste real keys into an agent chat.

# Postgres
POSTGRES_USER=aichallenge
POSTGRES_PASSWORD=changeme
POSTGRES_DB=aichallenge
DATABASE_URL=postgresql+asyncpg://aichallenge:changeme@db:5432/aichallenge

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
LLM_PROBE_ENABLED=true

# CORS — comma-separated origins. Required only when the browser talks to the API
# on a different origin (local Vite dev on :5173). Leave empty behind the nginx proxy.
CORS_ALLOW_ORIGINS=http://localhost:5173

# Input / context limits
MAX_MESSAGE_CHARS=8000
MAX_HISTORY_MESSAGES=40

# Scenarios (optional; defaults to repo configs/scenarios/)
SCENARIOS_DIR=

# ---------------------------------------------------------------------------
# LLM (один провайдер за раз: один BASE_URL + один KEY)
# Скопируй в `.env` и заполни. Реальные ключи — только в `.env` / на сервере,
# никогда в git и не в чат агенту.
# Set USE_FAKE_LLM=true чтобы крутить стек без ключа.
# ---------------------------------------------------------------------------
USE_FAKE_LLM=false

# --- Вариант A: OpenRouter (бесплатные :free) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL_CHAIN=openrouter/free,meta-llama/llama-3.3-70b-instruct:free,google/gemma-3-27b-it:free
LLM_HTTP_REFERER=https://aichallenge.arcilite.ru
LLM_APP_TITLE=AIChallenge
LLM_EXHAUSTED_TTL_SECONDS=300

# --- Вариант B: DeepSeek (раскомментируй и вставь ключ сюда; закомментируй блок A) ---
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=          <-- вставь DeepSeek API key сюда (в файле `.env`)
# LLM_MODEL_CHAIN=deepseek-chat,deepseek-reasoner
# LLM_HTTP_REFERER=
# LLM_APP_TITLE=AIChallenge
# LLM_EXHAUSTED_TTL_SECONDS=300

# Tests — integration suite is skipped unless this is set
RUN_INTEGRATION=

# Web
# NOTE: VITE_API_URL is BUILD-TIME only — Vite inlines it during `npm run build`.
# Setting it as a runtime env var on the nginx container has no effect.
# Leave empty to use the relative /api/v1 path proxied by nginx.
VITE_API_URL=
