# Env template — copy to `.env` and fill locally. Never commit `.env`.
# Values here are placeholders only. Never paste real keys into an agent chat.

# Postgres
POSTGRES_USER=aichallenge
POSTGRES_PASSWORD=changeme
POSTGRES_DB=aichallenge
DATABASE_URL=postgresql+asyncpg://aichallenge:changeme@db:5432/aichallenge

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Salt for visitor_hash / ip_hash (set a long random string in production)
VISITOR_HASH_SALT=
LLM_PROBE_ENABLED=true

# CORS — comma-separated origins. Required only when the browser talks to the API
# on a different origin (local Vite dev on :5173). Leave empty behind the nginx proxy.
CORS_ALLOW_ORIGINS=http://localhost:5173

# Input / context limits
MAX_MESSAGE_CHARS=8000
MAX_HISTORY_MESSAGES=40

# Scenarios (optional; defaults to repo configs/scenarios/)
SCENARIOS_DIR=

# ---------------------------------------------------------------------------
# LLM (один провайдер за раз: один BASE_URL + один KEY)
# Скопируй в `.env` и заполни. Реальные ключи — только в `.env` / на сервере,
# никогда в git и не в чат агенту.
# Set USE_FAKE_LLM=true чтобы крутить стек без ключа.
# ---------------------------------------------------------------------------
USE_FAKE_LLM=false

# --- Вариант A: RouterAI (РФ, OpenAI-compatible; по умолчанию) ---
# Каталог/цены: https://routerai.ru — ₽/токен, бесплатных chat нет.
# Ключ: LLM_API_KEY и/или ROUTERAI_KEY (если LLM_API_KEY пуст — берётся ROUTERAI_KEY).
# Цепочка ниже: баланс ум/цена (flash → qwen-235b → v3.2 → gemini-flash).
LLM_BASE_URL=https://routerai.ru/api/v1
LLM_API_KEY=
ROUTERAI_KEY=
LLM_MODEL_CHAIN=deepseek/deepseek-v4-flash,qwen/qwen3-235b-a22b-2507,deepseek/deepseek-v3.2,google/gemini-2.5-flash
LLM_HTTP_REFERER=https://aichallenge.arcilite.ru
LLM_APP_TITLE=AIChallenge
LLM_EXHAUSTED_TTL_SECONDS=300
# Границы работы на один запрос: сколько моделей из цепочки перебрать и
# сколько ждать первого токена от каждой. Без них длинная :free-цепочка
# превращает одно сообщение в минуты молчаливого перебора.
LLM_MAX_ATTEMPTS=3
LLM_FIRST_TOKEN_TIMEOUT_SECONDS=20
# Дешевле: mistralai/mistral-nemo,meta-llama/llama-3.1-8b-instruct,deepseek/deepseek-v4-flash

# --- Вариант B: OpenRouter (бесплатные :free; с RU IP часто 403 — нужен LLM_HTTP_PROXY) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# OPENROUTER_API_KEY=
# LLM_HTTP_PROXY=http://llm-proxy:11081
# LLM_MODEL_CHAIN=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3.5-lightning:free,minimax/minimax-m3:free,thinkingmachines/inkling:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,z-ai/glm-5.2:free,minimax/minimax-m2.7:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,poolside/laguna-s-2.1:free,cohere/north-mini-code:free,inclusionai/ling-3.0-flash-fin:free,openrouter/free,liquid/lfm-2.5-2.6b:free
# LLM_FALLBACK_BASE_URL=https://routerai.ru/api/v1
# LLM_FALLBACK_MODEL_CHAIN=deepseek/deepseek-v4-flash,qwen/qwen3-235b-a22b-2507,deepseek/deepseek-v3.2,google/gemini-2.5-flash
# ROUTERAI_KEY=

# --- Вариант C: DeepSeek напрямую ---
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=
# LLM_MODEL_CHAIN=deepseek-chat,deepseek-reasoner

# Tests — integration suite is skipped unless this is set
RUN_INTEGRATION=

# Web
# NOTE: VITE_API_URL is BUILD-TIME only — Vite inlines it during `npm run build`.
# Setting it as a runtime env var on the nginx container has no effect.
# Leave empty to use the relative /api/v1 path proxied by nginx.
VITE_API_URL=
