# Env template — copy to `.env` and fill locally. Never commit `.env`.

# Postgres
POSTGRES_USER=aichallenge
POSTGRES_PASSWORD=changeme
POSTGRES_DB=aichallenge
DATABASE_URL=postgresql+asyncpg://aichallenge:changeme@db:5432/aichallenge

# API
API_HOST=0.0.0.0
API_PORT=8000
LLM_PROBE_ENABLED=true

# LLM (OpenAI-compatible: OpenRouter, DeepSeek, etc.)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL_CHAIN=

# Web (optional; leave empty to use relative /api behind nginx)
VITE_API_URL=
