# Env template — copy to `.env` and fill locally. Never commit `.env`.
# Values here are placeholders only. Never paste real keys into an agent chat.

# Postgres
POSTGRES_USER=aichallenge
POSTGRES_PASSWORD=changeme
POSTGRES_DB=aichallenge
DATABASE_URL=postgresql+asyncpg://aichallenge:changeme@db:5432/aichallenge

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Salt for visitor_hash / ip_hash (set a long random string in production)
VISITOR_HASH_SALT=
LLM_PROBE_ENABLED=true

# CORS — comma-separated origins. Required only when the browser talks to the API
# on a different origin (local Vite dev on :5173). Leave empty behind the nginx proxy.
CORS_ALLOW_ORIGINS=http://localhost:5173

# Input / context limits
MAX_MESSAGE_CHARS=8000
MAX_HISTORY_MESSAGES=40

# Scenarios (optional; defaults to repo configs/scenarios/)
SCENARIOS_DIR=

# ---------------------------------------------------------------------------
# LLM (один провайдер за раз: один BASE_URL + один KEY)
# Скопируй в `.env` и заполни. Реальные ключи — только в `.env` / на сервере,
# никогда в git и не в чат агенту.
# Set USE_FAKE_LLM=true чтобы крутить стек без ключа.
# ---------------------------------------------------------------------------
USE_FAKE_LLM=false

# --- Вариант A: OpenRouter free → cheap paid, fallback RouterAI (рекомендуемый prod) ---
# Цель: ~90%+ успешных ответов при минимуме ₽: сначала :free, потом дешёвые платные OR,
# RouterAI только если оба tier'а primary исчерпаны.
USE_FAKE_LLM=false
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
OPENROUTER_API_KEY=
LLM_HTTP_PROXY=http://llm-proxy:11081
LLM_MODEL_CHAIN=openrouter/free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,google/gemini-2.5-flash,deepseek/deepseek-chat
LLM_HTTP_REFERER=https://aichallenge.arcilite.ru
LLM_APP_TITLE=AIChallenge
LLM_EXHAUSTED_TTL_SECONDS=180
LLM_MAX_ATTEMPTS=4
LLM_FIRST_TOKEN_TIMEOUT_SECONDS=18
ROUTERAI_KEY=
LLM_FALLBACK_BASE_URL=https://routerai.ru/api/v1
LLM_FALLBACK_HTTP_PROXY=
LLM_FALLBACK_MODEL_CHAIN=deepseek/deepseek-v4-flash,mistralai/mistral-nemo

# --- Вариант A2: RouterAI primary (если нужен платный first) ---
# LLM_BASE_URL=https://routerai.ru/api/v1
# LLM_API_KEY=
# ROUTERAI_KEY=
# LLM_HTTP_PROXY=
# LLM_MODEL_CHAIN=deepseek/deepseek-v4-flash,qwen/qwen3-235b-a22b-2507,deepseek/deepseek-v3.2,google/gemini-2.5-flash
# LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
# LLM_FALLBACK_HTTP_PROXY=http://llm-proxy:11081
# LLM_FALLBACK_MODEL_CHAIN=openrouter/free,nvidia/nemotron-3-super-120b-a12b:free,google/gemini-2.5-flash,deepseek/deepseek-chat

# ---------------------------------------------------------------------------
# Media tools (optional) — free cloud image/video via chat tool-calling
# Pollinations (картинки, ключ необязателен) + Pixazo LTX (видео, нужен ключ).
# Off by default. Same free endpoints as Kalinin SkyNet /pollinations + /pixazo.
# ---------------------------------------------------------------------------
MEDIA_TOOLS_ENABLED=false
POLLINATIONS_API_KEY=
PIXAZO_API_KEY=
MEDIA_DIR=
MEDIA_IMAGE_LIMIT_PER_HOUR=20
MEDIA_VIDEO_LIMIT_PER_HOUR=5

# ---------------------------------------------------------------------------
# Observability: run traces, model ranking, feedback → routing
# Traces feed «Модели» → Рейтинг; thumbs feed → Оценки and bias the chain.
# ---------------------------------------------------------------------------
RUN_TRACE_ENABLED=true
# Relative cost per model id, JSON: {"model-a": 0.2, "model-b": 1.0}. Empty = no cost column.
MODEL_COST_PROXY_JSON=
# A model whose «Не полезно» share reaches the threshold (over at least MIN_VOTES
# votes inside the TTL window) drops to the end of the auto chain. An explicit
# pin always wins, and the model is never removed from the chain.
FEEDBACK_DOWN_RATE_THRESHOLD=0.6
FEEDBACK_MIN_VOTES=5
FEEDBACK_PENALTY_TTL_SECONDS=86400
FEEDBACK_PENALTY_REFRESH_SECONDS=60
# Preference export is off by default; it names concrete messages.
FEEDBACK_EXPORT_ENABLED=false
FEEDBACK_EXPORT_INCLUDE_CONTENT=false

# ---------------------------------------------------------------------------
# Cascade (FrugalGPT-style): cheap model first, escalate only if the answer
# does not hold up. Off by default — it changes how the chat behaves.
# The cheap stage is non-streaming, so escalation happens before the reader
# sees any character; an accepted cheap answer arrives in one piece.
# ---------------------------------------------------------------------------
CASCADE_ENABLED=false
# csv; empty = first model of LLM_MODEL_CHAIN
CASCADE_CHEAP_MODELS=
CASCADE_SCORE_THRESHOLD=0.75
CASCADE_MIN_ANSWER_CHARS=40
# A question longer than this never goes to the cheap model at all.
CASCADE_MAX_CHEAP_CHARS=1200
CASCADE_TIMEOUT_SECONDS=12

# --- Вариант B: OpenRouter (бесплатные :free; с RU IP часто 403 — нужен LLM_HTTP_PROXY) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# OPENROUTER_API_KEY=
# LLM_HTTP_PROXY=http://llm-proxy:11081
# LLM_MODEL_CHAIN=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3.5-lightning:free,minimax/minimax-m3:free,thinkingmachines/inkling:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,z-ai/glm-5.2:free,minimax/minimax-m2.7:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,poolside/laguna-s-2.1:free,cohere/north-mini-code:free,inclusionai/ling-3.0-flash-fin:free,openrouter/free,liquid/lfm-2.5-2.6b:free
# LLM_FALLBACK_BASE_URL=https://routerai.ru/api/v1
# LLM_FALLBACK_MODEL_CHAIN=deepseek/deepseek-v4-flash,qwen/qwen3-235b-a22b-2507,deepseek/deepseek-v3.2,google/gemini-2.5-flash
# ROUTERAI_KEY=

# --- Вариант C: DeepSeek напрямую ---
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=
# LLM_MODEL_CHAIN=deepseek-chat,deepseek-reasoner

# Tests — integration suite is skipped unless this is set
RUN_INTEGRATION=

# Web
# NOTE: VITE_API_URL is BUILD-TIME only — Vite inlines it during `npm run build`.
# Setting it as a runtime env var on the nginx container has no effect.
# Leave empty to use the relative /api/v1 path proxied by nginx.
VITE_API_URL=
